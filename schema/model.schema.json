{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incarterseyes/listofaimodelsthatarefullyonchain/schema/model.schema.json",
  "title": "Onchain Model Registry entry",
  "description": "One neural network that is stored fully on Ethereum mainnet. Ethereum mainnet must store both the weights and the code that runs the model or draws its output. The file name must be <slug>.json.",
  "type": "object",
  "required": ["slug", "title", "author", "year", "month", "address", "facts", "description", "call", "links"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A stable identifier in kebab-case. It must match the file name."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "year": { "type": "integer", "minimum": 2015, "maximum": 2100, "description": "The year of the model's release on mainnet." },
    "month": { "type": "integer", "minimum": 1, "maximum": 12, "description": "The month of the model's release on mainnet (1–12). For a shared contract, use the project's release date, not the deployment date of the core contract." },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "The contract that the registered call targets."
    },
    "facts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[A-Z][A-Z0-9 _-]*$" },
          { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      },
      "description": "Pairs of a label and a value. The site shows them as the entry's table. They answer the reader's questions in a fixed order. TYPE, SIZE, STORAGE, and OUTPUT are required. TRAINING is optional and goes between STORAGE and OUTPUT. See lib/models.ts and CONTRIBUTING.md for the full rules."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 700, "pattern": "\\S" },
    "call": {
      "type": "object",
      "required": ["calldata", "expectedReturnBytes", "note"],
      "additionalProperties": false,
      "properties": {
        "calldata": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})*$",
          "description": "Pre-encoded calldata for an eth_call to `address`. The call must return at least one byte."
        },
        "expectedReturnBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "description": "The exact length in bytes of the raw JSON-RPC result, including ABI framing."
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "description": "What the call computes, for example \"isYingYang() runs the model\"." },
        "input": { "$ref": "#/$defs/callInput" },
        "manualReturn": { "enum": ["text", "svg", "token-uri", "market-state"], "description": "The output format that the site checks when a custom input can change the result length. The registered example keeps its exact size check." }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S" },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      },
      "description": "At most three links, in this order: SITE (the project), ABOUT (a writeup), and CONTRACT (the entry's address on evm.now). CONTRACT is required. See lib/models.ts and CONTRIBUTING.md for the full rules."
    },
    "preview": {
      "description": "Optional. Declares how to decode the returned bytes. The site shows the decoded result after a live check passes.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["text", "market-state"] },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "An ABI string that contains program text, or the (uint256, string, uint256, string) tuple that stateAt returns."
        },
        {
          "type": "object",
          "required": ["kind", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "grayscale-image" },
            "width": { "type": "integer", "minimum": 1, "maximum": 256 },
            "height": { "type": "integer", "minimum": 1, "maximum": 256 },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "One byte for each pixel, row by row. The bytes are raw or in ABI dynamic-bytes framing."
        },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fields" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["label", "type"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[A-Z][A-Z0-9 _-]*$" },
                  "type": { "enum": ["bool", "uint8", "uint256", "int256"] }
                }
              }
            },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "Static ABI return values in order, one 32-byte word for each field."
        },
        {
          "type": "object",
          "required": ["kind", "topK"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "logits" },
            "topK": { "type": "integer", "minimum": 1, "maximum": 10 },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "An ABI dynamic array of signed logits, which are the raw scores of the model. The preview shows the topK tokens with the highest scores."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "words" },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "A fallback that lists each 32-byte word of the returned data."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "svg" },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "An ABI-encoded string that contains an SVG document. The site shows it as an image."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "token-uri" },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "An ABI-encoded string that contains base64 ERC-721 JSON metadata. The metadata must hold its image as a data: URI. The site shows that image."
        }
      ]
    }
  },
  "$defs": {
    "callInput": {
      "type": "object",
      "required": ["kind", "label", "example", "hint"],
      "properties": {
        "kind": { "enum": ["uint", "text", "uint-array"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
        "example": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "hint": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" }
      },
      "oneOf": [
        {
          "required": ["word", "max"],
          "properties": {
            "kind": { "const": "uint" },
            "word": { "type": "integer", "minimum": 0, "maximum": 10 },
            "max": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,77})$" },
            "allowHex": { "type": "boolean" }
          }
        },
        {
          "required": ["maxBytes", "maxWords", "pattern", "patternMessage"],
          "properties": {
            "kind": { "const": "text" },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxWords": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 500, "description": "A JavaScript regular expression, used with the Unicode flag. Start it with ^ and end it with $ to match the complete input." },
            "patternMessage": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S", "description": "The error message that the visitor sees when the input does not match the pattern. Use plain words." }
          }
        },
        {
          "required": ["maxValue", "maxItems"],
          "properties": {
            "kind": { "const": "uint-array" },
            "maxValue": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 512 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "previewNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "description": "A short note that the site shows under the preview. Use it to say what the preview cannot show."
    }
  }
}

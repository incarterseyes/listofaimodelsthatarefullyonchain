{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/incarterseyes/listofaimodelsthatarefullyonchain/schema/model.schema.json",
  "title": "Onchain Model Register entry",
  "description": "One fully-onchain neural network. The model's weights AND its inference/renderer code must live on Ethereum mainnet. The file name must be <slug>.json.",
  "type": "object",
  "required": ["slug", "title", "author", "year", "month", "address", "facts", "description", "call", "links"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier; must match the file name."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "year": { "type": "integer", "minimum": 2015, "maximum": 2100, "description": "Year the model was released on mainnet." },
    "month": { "type": "integer", "minimum": 1, "maximum": 12, "description": "Month the model was released on mainnet (1–12). For shared contracts, use the project's release, not the core contract's deployment." },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "The contract holding the weights (and the inference code, if the model runs inside the EVM)."
    },
    "facts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[A-Z][A-Z0-9 _-]*$" },
          { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" }
        ],
        "minItems": 2,
        "maxItems": 2,
        "items": false
      },
      "description": "LABEL/VALUE pairs rendered as the entry's table: the reader's questions, answered in a fixed order. TYPE, SIZE, STORAGE, OUTPUT are required; TRAINING is the one optional row, between STORAGE and OUTPUT. Full rules in lib/models.ts and CONTRIBUTING.md."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 700, "pattern": "\\S" },
    "call": {
      "type": "object",
      "required": ["calldata", "expectedReturnBytes", "note"],
      "additionalProperties": false,
      "properties": {
        "calldata": {
          "type": "string",
          "pattern": "^0x([0-9a-fA-F]{2})*$",
          "description": "Pre-encoded calldata for an eth_call against `address` that must return non-empty bytes."
        },
        "expectedReturnBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "description": "Exact byte length of the raw JSON-RPC result, including ABI framing."
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "description": "What the call computes, e.g. \"isYingYang() — runs the model\"." },
        "input": { "$ref": "#/$defs/callInput" },
        "manualReturn": { "enum": ["text", "svg", "token-uri", "market-state"], "description": "Output format checked for custom inputs whose return length can vary. The example retains its exact byte-size check." }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "\\S" },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      },
      "description": "At most three links, in this order: SITE (the project), ABOUT (a writeup), CONTRACT (required — the entry's address on evm.now). Full rules in lib/models.ts and CONTRIBUTING.md."
    },
    "preview": {
      "description": "Optional declarative decoder for the call's return bytes, rendered as a human-readable preview after a successful live check.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["text", "market-state"] },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "An ABI string containing program text, or the (uint256, string, uint256, string) tuple returned by stateAt."
        },
        {
          "type": "object",
          "required": ["kind", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "grayscale-image" },
            "width": { "type": "integer", "minimum": 1, "maximum": 256 },
            "height": { "type": "integer", "minimum": 1, "maximum": 256 },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "One byte per pixel, row-major; raw or in ABI dynamic-bytes framing."
        },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fields" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["label", "type"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[A-Z][A-Z0-9 _-]*$" },
                  "type": { "enum": ["bool", "uint8", "uint256", "int256"] }
                }
              }
            },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "Static ABI return values, one 32-byte word per field, in order."
        },
        {
          "type": "object",
          "required": ["kind", "topK"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "logits" },
            "topK": { "type": "integer", "minimum": 1, "maximum": 10 },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "ABI dynamic array of signed logits; shows the topK highest-scoring token indices."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "words" },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "Fallback: lists each 32-byte word of the return data."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "svg" },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "ABI-encoded string containing an SVG document; rendered as an image."
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "token-uri" },
            "note": { "$ref": "#/$defs/previewNote" }
          },
          "description": "ABI-encoded string containing base64 ERC-721 JSON metadata with a self-contained data: image; rendered as an image."
        }
      ]
    }
  },
  "$defs": {
    "callInput": {
      "type": "object",
      "required": ["kind", "label", "example", "hint"],
      "properties": {
        "kind": { "enum": ["uint", "text", "uint-array"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
        "example": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "hint": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" }
      },
      "oneOf": [
        {
          "required": ["word", "max"],
          "properties": {
            "kind": { "const": "uint" },
            "word": { "type": "integer", "minimum": 0, "maximum": 10 },
            "max": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,77})$" },
            "allowHex": { "type": "boolean" }
          }
        },
        {
          "required": ["maxBytes", "maxWords"],
          "properties": {
            "kind": { "const": "text" },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 64 },
            "maxWords": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        {
          "required": ["maxValue", "maxItems"],
          "properties": {
            "kind": { "const": "uint-array" },
            "maxValue": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 512 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "previewNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "description": "Honest caveat rendered under the preview, e.g. what cannot be decoded onchain."
    }
  }
}
